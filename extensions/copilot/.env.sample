# Copy this file to .env. The .env file is ignored by Git.
# Create the token with @BotFather. Never commit or paste the token into logs or issue reports.
TELEGRAM_BOT_TOKEN=

# Optional: numeric private-chat ID used only when the explicit send-message flag is true.
TELEGRAM_TEST_CHAT_ID=

# Keep false for a read-only getMe/getUpdates smoke test.
TELEGRAM_REAL_TEST_SEND_MESSAGE=false
